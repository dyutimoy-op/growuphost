# GROWUPHOST cPanel & LiteSpeed Production Configuration
DirectoryIndex disabled
RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. LiteSpeed Web Server (LSWS) Turbo Cache Engine
<IfModule LiteSpeed>
  # Turn on LiteSpeed Cache Lookup
  CacheLookup on
  RewriteEngine on

  # Never cache Admin panel, Dashboard, Auth, or POST requests
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [OR]
  RewriteCond %{REQUEST_URI} ^/(auth|dashboard|api) [NC] [OR]
  RewriteCond %{HTTP_COOKIE} (sb-access-token|sb-refresh-token|supabase|phpsessid) [NC]
  RewriteRule .* - [E=Cache-Control:no-cache]

  # Cache public visitor pages (Home, Packages, About, etc.) for 10 minutes (600s)
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{REQUEST_URI} !^/(auth|dashboard|api) [NC]
  RewriteCond %{HTTP_COOKIE} !(sb-access-token|sb-refresh-token|supabase|phpsessid) [NC]
  RewriteRule .* - [E=Cache-Control:max-age=600]

  # Enable LiteSpeed Brotli & GZIP compression
  RewriteRule .* - [E=no-gzip:0]
</IfModule>

# 3. HTTP/3 & QUIC Support (Advertises ultra-fast UDP protocol to mobile devices)
<IfModule mod_headers.c>
  Header always set Alt-Svc 'h3=":443"; ma=2592000, h3-29=":443"; ma=2592000'
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Fallback GZIP Compression (For standard Apache if LiteSpeed module not present)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# 5. Browser Caching for Static Assets (1 Year for Media/Fonts, 1 Month for CSS/JS)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/ico "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 6. Serve pre-built static files directly from .output/public without hitting Node.js
RewriteCond %{DOCUMENT_ROOT}/.output/public%{REQUEST_URI} -f
RewriteRule ^(.*)$ /.output/public/$1 [L]

# 7. Forward all dynamic requests to Node.js backend (Port 3000)
<IfModule mod_proxy.c>
  RewriteRule ^$ http://127.0.0.1:3000/ [P,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>
